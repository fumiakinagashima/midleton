{
  "name": "midleton",
  "version": "0.0.0",
  "description": "Lightweight, dependency-free backend framework for AI-native apps on Cloudflare Workers",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fumiakinagashima/midleton.git",
